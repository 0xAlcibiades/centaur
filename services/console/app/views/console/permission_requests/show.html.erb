<% content_for :title, "Permission Request #{@permission_request.oid} - Centaur Console" %>

<div class="mb-8 text-center">
  <%= image_tag "centaur-lockup-white.svg", alt: "Centaur", class: "mx-auto h-9 w-auto", width: 497, height: 127 %>
  <p class="page-subtitle mt-4">Permission request review.</p>
</div>

<% if flash[:notice] %>
  <div class="mb-6 rounded border border-ink-600 bg-ink-850/60 px-4 py-3 text-sm text-zinc-400"><%= flash[:notice] %></div>
<% end %>

<div class="rounded-xl border border-ink-600 bg-ink-850/60 p-6">
  <% if flash[:alert] %>
    <div class="alert-error"><%= flash[:alert] %></div>
  <% end %>

  <div class="mb-5 flex items-center justify-between gap-3">
    <div>
      <h1 class="text-lg font-semibold text-zinc-100">Permission Request</h1>
      <p class="mt-1 text-xs text-zinc-500"><%= @permission_request.oid %></p>
    </div>
    <span class="rounded border border-ink-600 px-2 py-1 text-xs uppercase tracking-wider text-zinc-400">
      <%= @permission_request.status %>
    </span>
  </div>

  <div class="space-y-5 text-sm">
    <div>
      <div class="mb-1 text-xs font-semibold uppercase tracking-wider text-zinc-500">Requester</div>
      <div class="text-zinc-100"><%= @permission_request.requesting_slack_channel_id %></div>
      <div class="mt-1 text-xs text-zinc-500"><%= @permission_request.requesting_principal.name.presence || @permission_request.requesting_principal.oid %></div>
    </div>

    <div>
      <div class="mb-1 text-xs font-semibold uppercase tracking-wider text-zinc-500">Request</div>
      <div class="whitespace-pre-wrap text-zinc-100"><%= @permission_request.text_request %></div>
    </div>

    <% unless @permission_request.pending? %>
      <div>
        <div class="mb-1 text-xs font-semibold uppercase tracking-wider text-zinc-500">Decision</div>
        <div class="text-zinc-100">
          <%= @permission_request.status.titleize %> by <%= @permission_request.decided_by.email %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @permission_request.pending? %>
    <div class="mt-6 grid grid-cols-2 gap-3">
      <%= button_to "Deny",
                    deny_console_permission_request_path(@permission_request.oid),
                    method: :post,
                    class: "w-full rounded border border-ink-600 bg-ink-800/60 px-4 py-2 text-sm text-zinc-300 transition-colors hover:text-zinc-100" %>
      <%= button_to "Approve",
                    approve_console_permission_request_path(@permission_request.oid),
                    method: :post,
                    class: "w-full rounded border border-centaur-500/40 bg-centaur-500/10 px-4 py-2 text-sm text-centaur-300 transition-colors hover:bg-centaur-500/20 hover:text-centaur-200" %>
    </div>
  <% end %>
</div>
